{
	"name": "axolotl-pm/nethernet",
	"description": "A NetherNet (WebRTC) transport implementation written in PHP",
	"type": "library",
	"license": "LGPL-3.0-or-later",
	"require": {
		"php": "^8.1",
		"php-64bit": "*",
		"php-ipv6": "*",
		"ext-encoding": "~1.0.0",
		"ext-hash": "*",
		"ext-json": "*",
		"ext-openssl": "*",
		"ext-sockets": "*",
		"ext-webrtc": "*",
		"pocketmine/log": "^0.4.0"
	},
	"require-dev": {
		"phpstan/phpstan": "2.1.46",
		"phpstan/phpstan-phpunit": "^2.0.0",
		"phpstan/phpstan-strict-rules": "^2.0.0",
		"phpunit/phpunit": "^10.5.24"
	},
	"autoload": {
		"psr-4": {
			"pocketmine\\nethernet\\": "src/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"pocketmine\\nethernet\\": "tests/phpunit/"
		}
	},
	"config": {
		"platform": {
			"php": "8.1.0"
		},
		"sort-packages": true
	},
	"scripts": {
		"phpstan": "phpstan analyse --no-progress",
		"phpunit": "phpunit --bootstrap vendor/autoload.php --cache-directory .phpunit.cache --colors=auto --order-by=random --disallow-test-output --fail-on-warning --fail-on-risky --fail-on-deprecation --fail-on-notice --fail-on-phpunit-deprecation tests/phpunit"
	}
}
