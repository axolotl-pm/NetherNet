includes:
	- vendor/phpstan/phpstan-phpunit/extension.neon
	- vendor/phpstan/phpstan-phpunit/rules.neon
	- vendor/phpstan/phpstan-strict-rules/rules.neon

parameters:
	level: 9
	phpVersion: 80100
	checkMissingCallableSignature: true
	treatPhpDocTypesAsCertain: false
	paths:
		- src
		- tests/phpunit

	# stubFiles only replaces the type information for symbols PHP already knows
	# about, so on a machine without ext-webrtc every class in it is simply absent.
	# Scanning the same files declares that they exist, which is what lets CI
	# analyse this library without building the extension first.
	scanDirectories:
		- stubs
